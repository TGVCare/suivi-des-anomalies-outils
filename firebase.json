{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "functions/**",
      "**/.git/**",
      "**/.github/**",
      "**/node_modules/**",
      "*firebase-adminsdk*.json",
      "*.docx",
      "*.xlsx",
      "*.pptx",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "~$*",
      ".DS_Store",
      ".firebaserc",
      "*.md"
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
